<Project Sdk="Microsoft.NET.Sdk">
  <!-- NETLOAD plugin for Civil 3D 2027 (.NET 10). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LiveSync.Civil3d</RootNamespace>
    <AcadDir>C:\Program Files\Autodesk\AutoCAD 2027\</AcadDir>
    <!-- Host already provides these; don't emit a deps.json that pins framework versions. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: never copy host assemblies next to the plugin. -->
    <Reference Include="acdbmgd"><HintPath>$(AcadDir)acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(AcadDir)acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="accoremgd"><HintPath>$(AcadDir)accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AeccDbMgd"><HintPath>$(AcadDir)C3D\AeccDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AecBaseMgd"><HintPath>$(AcadDir)ACA\AecBaseMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\LiveSync.Shared.csproj" />
  </ItemGroup>

  <!--
    NETLOAD locks the DLL until Civil 3D exits, so a rebuild can't overwrite a loaded copy.
    Each build is copied to its own deploy\civil3d\<timestamp>\ folder, and livesync-load.lsp
    is rewritten to NETLOAD the newest one. Old folders can be deleted once Civil 3D is closed.
  -->
  <Target Name="DeployVersioned" AfterTargets="Build">
    <PropertyGroup>
      <DeployRoot>$(LOCALAPPDATA)\C3dRevitLiveSync\deploy\civil3d\</DeployRoot>
      <DeployStamp>$([System.DateTime]::Now.ToString("yyyyMMdd-HHmmss"))</DeployStamp>
      <DeployDir>$(DeployRoot)$(DeployStamp)\</DeployDir>
      <DeployDll>$(DeployDir)$(TargetFileName)</DeployDll>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(DeployDir)" />
    <!-- ';' separates items in Lines, so the LISP comment semicolons are escaped as %3B. -->
    <WriteLinesToFile File="$(DeployRoot)livesync-load.lsp" Overwrite="true"
                      Lines="%3B%3B Generated by the build. APPLOAD this file (or add it to the Startup Suite).;(command &quot;_.NETLOAD&quot; &quot;$(DeployDll.Replace('\', '/'))&quot;);(princ)" />
    <Message Importance="high" Text="LiveSync Civil 3D plugin deployed: $(DeployDll)" />
  </Target>
</Project>
