<Project Sdk="Microsoft.NET.Sdk">
  <!-- Revit 2027 (.NET 10) add-in: LiveSync receiver. Separate from the MCP add-in. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LiveSync.Revit</RootNamespace>
    <RevitDir>C:\Program Files\Autodesk\Revit 2027\</RevitDir>
    <!-- Host already provides the framework; don't emit a deps.json that pins versions. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installed Revit's own DLLs (27.2), not NuGet: compiles against exactly the runtime
         API, and avoids Nice3point.Revit.Build.Tasks auto-publishing into Addins\2027. -->
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\LiveSync.Shared.csproj" />
  </ItemGroup>

  <!--
    Revit loads add-ins at startup and locks the DLLs until it exits. Each build is copied to its
    own deploy\revit\<timestamp>\ folder and the manifest in Addins\2027 is rewritten to point at it,
    so building works while Revit is open; the new build is picked up on the next Revit start.
  -->
  <Target Name="DeployVersioned" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <DeployRoot>$(LOCALAPPDATA)\C3dRevitLiveSync\deploy\revit\</DeployRoot>
      <DeployStamp>$([System.DateTime]::Now.ToString("yyyyMMdd-HHmmss"))</DeployStamp>
      <DeployDir>$(DeployRoot)$(DeployStamp)\</DeployDir>
      <DeployDll>$(DeployDir)$(TargetFileName)</DeployDll>
      <AddinFile>$(APPDATA)\Autodesk\Revit\Addins\2027\LiveSync.Revit.addin</AddinFile>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(DeployDir)" />
    <WriteLinesToFile File="$(AddinFile)" Overwrite="true" Encoding="utf-8"
                      Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;
&lt;!-- Generated by the LiveSync build. Points at the newest deploy folder. --&gt;
&lt;RevitAddIns&gt;
  &lt;AddIn Type=&quot;Application&quot;&gt;
    &lt;Name&gt;LiveSync Receiver&lt;/Name&gt;
    &lt;Assembly&gt;$(DeployDll)&lt;/Assembly&gt;
    &lt;FullClassName&gt;LiveSync.Revit.App&lt;/FullClassName&gt;
    &lt;ClientId&gt;6B0E3F51-7C2A-4D8E-9A41-2F5C3D7B9E10&lt;/ClientId&gt;
    &lt;VendorId&gt;LiveSync&lt;/VendorId&gt;
    &lt;VendorDescription&gt;Civil 3D to Revit live surface sync&lt;/VendorDescription&gt;
  &lt;/AddIn&gt;
&lt;/RevitAddIns&gt;" />
    <Message Importance="high" Text="LiveSync Revit add-in deployed: $(DeployDll) (manifest $(AddinFile))" />
  </Target>
</Project>
